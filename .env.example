# ===========================================
# CONTOH FILE .env  (JANGAN ISI DENGAN NILAI ASLI DI FILE INI)
# ===========================================
# Cara pakai:
#   1. Salin file ini menjadi `.env`     (cp .env.example .env)
#   2. Isi nilai-nilai di bawah dengan kredensial asli Anda
#   3. JANGAN PERNAH commit file `.env` ke git
#
# Catatan keamanan:
#   - Generate SECRET_KEY baru per-environment (lokal vs production)
#   - DEBUG harus False di server production
#   - Password DB / API key tidak boleh sama antara lokal & production

# ===========================================
# DJANGO CORE
# ===========================================
# Generate baru: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=ganti-dengan-random-string-50-karakter

# True hanya untuk pengembangan lokal. PRODUCTION HARUS False.
DEBUG=True

# Domain/IP yang diizinkan akses sistem (pisahkan koma)
# Lokal:        localhost,127.0.0.1
# Production:   domainanda.com,www.domainanda.com,IP_VPS_ANDA
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# Format: postgres://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# Lokal pgAdmin:  postgres://postgres:passwordlokal@localhost:5432/db_pk_imm
# VPS:            postgres://postgres:passwordvps@127.0.0.1:5432/DB_PK_IMM
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/NAMA_DATABASE

# ===========================================
# OPENAI (untuk fitur Chatbot AI & Smart Editor)
# ===========================================
# Dapatkan dari: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-3.5-turbo

# Admin API key untuk dashboard billing (OPSIONAL — boleh kosong)
OPENAI_ADMIN_API_KEY=

# ===========================================
# EMAIL (untuk OTP reset password)
# ===========================================
# Gmail dengan App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=email-anda@gmail.com
EMAIL_HOST_PASSWORD=app-password-16-karakter
DEFAULT_FROM_EMAIL=noreply@pk-imm-umko.com

# ===========================================
# SSO UMKO API
# ===========================================
SSO_API_BASE_URL=https://sso.umko.ac.id/api/v1
SSO_API_KEY=ganti-dengan-api-key-sso
SSO_SECRET_KEY=ganti-dengan-secret-key-sso
